{
  "name": "ccslot",
  "version": "0.2.0",
  "description": "Run multiple Claude Code accounts on one machine. Separate logins, shared projects/skills/plans/settings.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "cli",
    "accounts",
    "profiles",
    "CLAUDE_CONFIG_DIR"
  ],
  "license": "MIT",
  "author": "Sumanta Kabiraj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumantadotai/ccslot.git"
  },
  "homepage": "https://github.com/sumantadotai/ccslot#readme",
  "bugs": "https://github.com/sumantadotai/ccslot/issues",
  "type": "module",
  "bin": {
    "ccslot": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm build && vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "pnpm --dir docs start",
    "docs:build": "pnpm --dir docs build",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.1.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.10.0",
  "lint-staged": {
    "*.{ts,js,json,css,md,yml}": "prettier --write"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
