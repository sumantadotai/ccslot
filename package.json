{
  "name": "ccslot",
  "version": "0.1.0",
  "description": "Run multiple Claude Code accounts on one machine. Separate logins, shared projects/skills/plans/settings.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "cli",
    "accounts",
    "profiles",
    "CLAUDE_CONFIG_DIR"
  ],
  "license": "MIT",
  "author": "Sumanta Kabiraj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumantadotai/ccslot.git"
  },
  "homepage": "https://github.com/sumantadotai/ccslot#readme",
  "bugs": "https://github.com/sumantadotai/ccslot/issues",
  "type": "module",
  "bin": {
    "ccslot": "bin/ccslot.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "changeset publish",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "pnpm --dir docs start",
    "docs:build": "pnpm --dir docs build",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.10.0",
  "lint-staged": {
    "*.{js,json,css,md,yml}": "prettier --write",
    "*.js": "vitest related --run"
  }
}
